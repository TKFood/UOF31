<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="LOG等級" value="3" />
    <add key="LOG儲存類型" value="HOUR" />
    <add key="LOG路徑" value="C:\inetpub\wwwroot\UOF\App_Data\ZBPMLogs" />
    <add key="LOGClass" value="Both" />
    <add key="PUBLIC_SYSTEM_CODE" value="KYTI_API" />
    <add key="TOKEN_PUBLICKEY" value="" />
    <add key="UOF_DEFAULT_ACCOUNT" value="admin" />
    <add key="UOF_DEFAULT_PASSWORD" value="123456" />
  </appSettings>
  <appSettingsName>
    <add key="LOG等級" value="LOG等級" type="number" />
    <add key="LOG儲存類型" value="LOG儲存類型" type="text" />
    <add key="LOG路徑" value="LOG路徑" type="text" />
    <add key="LOGClass" value="LOG寫入類別(Both(同時寫入資料庫和IO)、OnlyFile(不寫入資料庫，只寫入IO)、OnlyDB(不寫入IO，只寫入資料庫))" type="text" />
    <add key="PUBLIC_SYSTEM_CODE" value="通用驗證名稱" type="text" />
    <add key="TOKEN_PUBLICKEY" value="通用驗證公鑰" type="text" />
    <add key="UOF_DEFAULT_ACCOUNT" value="通用驗證UOF帳號" type="text" />
    <add key="UOF_DEFAULT_PASSWORD" value="通用驗證UOF密碼" type="text" />
  </appSettingsName>
</configuration>